---
import Button from './Button.astro';
import { appendChangelogNotes } from '../utils/changelogNotes';
import { getLatestChangelog } from '../utils/changelogState.mjs';
import { isStagingEnvironment } from '../utils/cheatsAvailability';
import { logServerError } from '../utils/serverLogger';

let changelogs = [];
let changelogError: Error | undefined;
let latestUpdateHtml: string | undefined;
let latestUpdateTitle: string | undefined;
let latestUpdateIsDraft = false;
let changelogRenderError: Error | undefined;
const route = Astro.url?.pathname ?? '/';
const method = Astro.request?.method ?? 'GET';

function prepareHtml(html, slug) {
    const withNotes = appendChangelogNotes(html, slug);
    return withNotes + `
        <style>
            .latest-update-html img {
                max-width: 100%;
                width: auto;
                height: auto;
                border-radius: 20px;
            }

            /*
             * One-off cap for the 2026-04-01 changelog hero image hook.
             * Keep this selector in sync with /changelog styles and E2E coverage.
             */
            .latest-update-html img.changelog-hero-image--20260401 {
                max-width: min(100%, 512px);
                display: block;
                margin: 0.75rem auto;
            }

        </style>
    `;
}

try {
    changelogs = Object.values(import.meta.glob('../pages/docs/md/changelog/*.md', { eager: true }));
} catch (error) {
    changelogError = error instanceof Error ? error : new Error(String(error));
    logServerError({
        route,
        method,
        message: 'Failed to load homepage changelog entries',
        error: changelogError,
        context: { url: Astro.url?.toString() },
    });
    changelogs = [];
}

try {
    const latest = getLatestChangelog(changelogs, isStagingEnvironment());
    if (latest) {
        latestUpdateIsDraft = latest.frontmatter.status === 'draft';
        latestUpdateTitle = latest?.frontmatter?.title;
        latestUpdateHtml = prepareHtml(await latest?.compiledContent(), latest?.frontmatter?.slug);
    }
} catch (error) {
    changelogRenderError = error instanceof Error ? error : new Error(String(error));
    logServerError({
        route,
        method,
        message: 'Failed to prepare homepage changelog content',
        error: changelogRenderError,
        context: { url: Astro.url?.toString() },
    });
    latestUpdateHtml = undefined;
    latestUpdateTitle = undefined;
}
---

<span class="wrapper">
    {latestUpdateHtml && latestUpdateTitle ? (
        <>
            <h3>
                {latestUpdateIsDraft ? 'Upcoming update (draft)' : 'Latest update'}: {latestUpdateTitle}
            </h3>
            {latestUpdateIsDraft && <p>Unpublished draft - date is tentative.</p>}
            <span class="latest-update-html" set:html={latestUpdateHtml}></span>
        </>
    ) : (
        <p class="fallback">Unable to load the latest updates right now.</p>
    )}
    <Button href="/changelog" text="View all updates" />
    {(changelogError || changelogRenderError) && (
        <p class="fallback">Please check back after a refresh.</p>
    )}
</span>

<style>
    span {
        background-color: white;
        color: black;
        padding: 10px;
        border-radius: 20px;
    }

    .wrapper {
        background-color: white;
        padding: 20px;
    }

    .fallback {
        margin: 0;
    }
</style>
